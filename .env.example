# Copy to .env and fill in. Never commit .env.
YEXT_SANDBOX_KEY=
YEXT_SANDBOX_ENTITY_ID=
SANDBOX_MIRRORS=FI-D0001
FRONTEND_URL=http://localhost:3000

# Owner links: days until a link stops working, and owner-page requests allowed per IP per minute
LINK_TTL_DAYS=21
RATE_LIMIT_PER_MIN=60

# Console view for first-time visitors: demo (judge controls visible) or clean
DEFAULT_VIEW=demo

# Live holiday calendar (free, no API key). Only change this to point at a mirror.
HOLIDAY_API_BASE=https://date.nager.at/api/v3

# Fonecta's Yext sandbox (never commit real values). On start, Visor renames the sandbox business to match
# the demo business (SANDBOX_MIRRORS) and clears its holiday hours; set SANDBOX_SYNC_PROFILE=0 to skip that.
SANDBOX_MIRRORS=FI-D0001
SANDBOX_SYNC_PROFILE=1
