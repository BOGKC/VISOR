# Copy to .env and fill in. Never commit .env.
YEXT_SANDBOX_KEY=
YEXT_SANDBOX_ENTITY_ID=
SANDBOX_MIRRORS=FI-D0001
FRONTEND_URL=http://localhost:3000

# Owner links: days until a link stops working, and owner-page requests allowed per IP per minute
LINK_TTL_DAYS=21
RATE_LIMIT_PER_MIN=60

# Console view for first-time visitors: demo (judge controls visible) or clean
DEFAULT_VIEW=demo
